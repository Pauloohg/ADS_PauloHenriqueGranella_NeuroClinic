DEBUG=True

# Troque pelos dados do seu PostgreSQL local
DATABASE_URL=postgresql+psycopg2://postgres:SUASENHA@localhost:5432/neuroclinic

# Gere uma chave forte antes de qualquer teste real, ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-antes-de-qualquer-coisa
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=30

# Preencher na Semana 4 (RF06)
ABACATEPAY_API_KEY=
ABACATEPAY_BASE_URL=https://api.abacatepay.com/v2

# Preencher quando for implementar envio de e-mail
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@neuroclinic.local
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
