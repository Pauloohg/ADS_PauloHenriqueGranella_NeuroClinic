# Desenvolvimento: True. Apresentação e qualquer uso real: False (com True um erro 500 mostra o traceback inteiro;
# com False o cookie de login é Secure e só funciona em https ou em localhost/127.0.0.1)
DEBUG=True

# Troque pelos dados do seu PostgreSQL local
DATABASE_URL=postgresql+psycopg2://postgres:SUASENHA@localhost:5432/neuroclinic

# Gere uma chave forte antes de qualquer teste real, ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-antes-de-qualquer-coisa
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=30

# Pagamento (RF06): chave de API da AbacatePay em Dev mode (escopo TRANSPARENT:CREATE e TRANSPARENT:READ)
ABACATEPAY_API_KEY=
ABACATEPAY_BASE_URL=https://api.abacatepay.com/v2
# O mesmo secret cadastrado no webhook do dashboard (Dev mode); a URL cadastrada é .../webhooks/abacatepay?webhookSecret=<este valor>
ABACATEPAY_WEBHOOK_SECRET=

# E-mail (redefinição de senha, confirmação de pagamento e liberação de avaliação)
# Desenvolvimento e apresentação: Email Sandbox do Mailtrap (usuário e senha da caixa; servidor sandbox.smtp.mailtrap.io, porta 2525)
# Gmail real: smtp.gmail.com, porta 587 e senha de app
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@neuroclinic.example
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Pasta das avaliações em PDF (RF09), fora de app/static
AVALIACOES_DIR=dados/avaliacoes